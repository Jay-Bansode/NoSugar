# Copy to apps/api/.env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
DATABASE_URL=postgresql://brand:brand@localhost:5432/brand?schema=public
REDIS_URL=redis://localhost:6379
# Proxies in front of the API (0 locally, 1 behind a load balancer). Decides the client IP.
TRUST_PROXY=0
# Three different random values, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=
# "console" prints codes to the terminal (development only; refused in production).
OTP_PROVIDER=console
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=
# Warehouse PIN code (delivery checks are made from here).
SHIPROCKET_PICKUP_PINCODE=
# "stub" answers delivery checks locally (development only); "shiprocket" calls the real API
# and needs SHIPROCKET_API_EMAIL, SHIPROCKET_API_PASSWORD and SHIPROCKET_PICKUP_PINCODE.
SHIPPING_PROVIDER=stub
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
EMAIL_PROVIDER_API_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
SENTRY_DSN=
SELLER_GSTIN=
SELLER_STATE_CODE=
FSSAI_LICENSE_NO=
