# Copy to apps/api/.env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
# Admin panel origin (apps/admin runs on 3002): the only browser origin allowed by CORS.
ADMIN_URL=http://localhost:3002
DATABASE_URL=postgresql://brand:brand@localhost:5432/brand?schema=public
REDIS_URL=redis://localhost:6379
# Proxies in front of the API (0 locally, 1 behind a load balancer). Decides the client IP.
TRUST_PROXY=0
# Four different random values, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=
ADMIN_JWT_SECRET=
# Encrypts admins' authenticator keys: exactly 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later means every admin sets up their authenticator app again.
ADMIN_TOTP_KEY=
# "console" prints codes to the terminal (development only; refused in production).
OTP_PROVIDER=console
# "fake" is an in-memory gateway for development (refused in production); "razorpay" needs
# the three values below (use test-mode keys until launch).
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Background jobs (BullMQ on Redis): webhooks, refunds, expiring unpaid orders.
JOBS_ENABLED=true
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=
# Warehouse PIN code (delivery checks are made from here).
SHIPROCKET_PICKUP_PINCODE=
# "stub" answers delivery checks locally (development only); "shiprocket" calls the real API
# and needs SHIPROCKET_API_EMAIL, SHIPROCKET_API_PASSWORD and SHIPROCKET_PICKUP_PINCODE.
SHIPPING_PROVIDER=stub
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
EMAIL_PROVIDER_API_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
SENTRY_DSN=
# Printed on GST invoices. Required in production; development uses placeholders and
# stamps PDFs "SPECIMEN".
SELLER_GSTIN=
SELLER_STATE_CODE=
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
FSSAI_LICENSE_NO=
