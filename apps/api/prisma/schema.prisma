// Prisma schema (CLAUDE.md §5). Change it only through migrations:
//   pnpm --filter @brand/api db:migrate --name <change>
// Conventions:
//   - money is integer paise (`*_paise Int`), GST rates are basis points (`gst_rate_bps Int`)
//   - tables/columns are snake_case via @@map/@map; ids are UUIDv7; timestamps are timestamptz
//   - CHECK constraints and append-only triggers live in the migration SQL (Prisma can't declare them)
// Phase 1 tables only. trial_claims / wallet_ledger (Phase 3) and admin tables (Phase 2)
// arrive with their own migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrderStatus {
  pending_payment
  payment_failed
  confirmed
  packed
  shipped
  out_for_delivery
  delivered
  undelivered
  rto
  returned
  cancelled
  refunded
  partially_refunded

  @@map("order_status")
}

enum PaymentMethod {
  prepaid
  cod

  @@map("payment_method")
}

enum PaymentStatus {
  created
  authorized
  captured
  failed

  @@map("payment_status")
}

enum RefundStatus {
  pending
  processed
  failed

  @@map("refund_status")
}

/// How the money goes back: through Razorpay, or paid outside the system (COD) by bank/UPI.
enum RefundMethod {
  razorpay
  manual

  @@map("refund_method")
}

enum ProductType {
  coffee
  trial_kit
  gift_set
  merchandise

  @@map("product_type")
}

enum DiscountType {
  percentage
  fixed

  @@map("discount_type")
}

enum DevicePlatform {
  ios
  android
  web

  @@map("device_platform")
}

enum OrderEventActor {
  system
  customer
  admin
  webhook

  @@map("order_event_actor")
}

enum InvoiceSeriesKind {
  invoice
  credit_note

  @@map("invoice_series_kind")
}

enum WebhookSource {
  razorpay
  shiprocket

  @@map("webhook_source")
}

// ─────────────────────────── Customers ───────────────────────────

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +919876543210. Null after account deletion (anonymised, orders kept for tax).
  phone              String?   @unique
  name               String?
  email              String?
  /// DPDP Act: explicit opt-in for marketing messages.
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  addresses           Address[]
  sessions            Session[]
  devices             Device[]
  carts               Cart[]
  orders              Order[]
  discountRedemptions DiscountRedemption[]

  @@map("users")
}

model Address {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  /// GST state code ("27" = Maharashtra); decides CGST+SGST vs IGST.
  stateCode String   @map("state_code") @db.Char(2)
  pincode   String   @db.Char(6)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// One row per refresh token. Rotation creates a new row and links the old one via
/// replaced_by_id; reuse of a rotated token revokes the whole family.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  /// HMAC-SHA256 (keyed with JWT_REFRESH_SECRET) of the refresh token; the token itself is never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Device {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  pushToken  String         @unique @map("push_token")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ──────────────────────────── Catalog ────────────────────────────

model Product {
  id             String      @id @default(uuid(7)) @db.Uuid
  slug           String      @unique
  name           String
  description    String?
  type           ProductType
  isActive       Boolean     @default(true) @map("is_active")
  /// Limited one-per-customer product (the trial kit). Enforced server-side in checkout.
  onePerCustomer Boolean     @default(false) @map("one_per_customer")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants        Variant[]
  media           ProductMedia[]
  collectionItems CollectionItem[]

  @@map("products")
}

model Variant {
  id            String   @id @default(uuid(7)) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique
  name          String
  /// Sachets per pack (6, 15); null for non-sachet items like the tumbler.
  packSize      Int?     @map("pack_size")
  mrpPaise      Int      @map("mrp_paise")
  /// Tax-inclusive selling price.
  pricePaise    Int      @map("price_paise")
  hsnCode       String   @map("hsn_code")
  gstRateBps    Int      @map("gst_rate_bps")
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock")
  weightG       Int      @map("weight_g")
  isActive      Boolean  @default(true) @map("is_active")
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  bundleItems BundleItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId])
  @@map("variants")
}

model ProductMedia {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  /// Object key in S3; URLs are built with CDN_BASE_URL at read time.
  storageKey String   @map("storage_key")
  alt        String
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model Collection {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_items")
}

/// Build-your-own bundle: the customer picks `slots` variants from bundle_items
/// (e.g. Bundle of 2 = any two 15-packs). Stock is taken from the chosen variants.
model Bundle {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  sku         String   @unique
  name        String
  description String?
  slots       Int
  mrpPaise    Int      @map("mrp_paise")
  pricePaise  Int      @map("price_paise")
  hsnCode     String   @map("hsn_code")
  gstRateBps  Int      @map("gst_rate_bps")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items      BundleItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("bundles")
}

model BundleItem {
  bundleId  String @map("bundle_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([bundleId, variantId])
  @@map("bundle_items")
}

// ──────────────────────────── Pricing ────────────────────────────

model Discount {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Stored upper-case.
  code             String       @unique
  type             DiscountType
  /// Percentage in basis points (type = percentage).
  valueBps         Int?         @map("value_bps")
  /// Flat amount (type = fixed).
  valuePaise       Int?         @map("value_paise")
  minSubtotalPaise Int          @default(0) @map("min_subtotal_paise")
  maxDiscountPaise Int?         @map("max_discount_paise")
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(3)
  usageLimit       Int?         @map("usage_limit")
  perCustomerLimit Int?         @map("per_customer_limit")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  redemptions DiscountRedemption[]
  orders      Order[]

  @@map("discounts")
}

model DiscountRedemption {
  id          String   @id @default(uuid(7)) @db.Uuid
  discountId  String   @map("discount_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([discountId])
  @@index([customerId])
  @@map("discount_redemptions")
}

// ───────────────────────────── Cart ──────────────────────────────

/// Server-side cart. Guest carts have no user and are addressed by id; at login a guest
/// cart is merged into the customer's cart.
model Cart {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String?  @unique @map("user_id") @db.Uuid
  /// Code the customer entered; re-validated every time the cart is priced.
  discountCode String?  @map("discount_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// Exactly one of variant_id / bundle_id is set (CHECK in migration).
model CartItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  bundleId        String?  @map("bundle_id") @db.Uuid
  /// For bundles: the chosen variant ids, length = bundle.slots.
  bundleSelection Json?    @map("bundle_selection")
  quantity        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bundle  Bundle?  @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

// ──────────────────────────── Orders ─────────────────────────────

model Order {
  id                   String        @id @default(uuid(7)) @db.Uuid
  /// Human-readable, e.g. "BR-2611-000123".
  number               String        @unique
  customerId           String        @map("customer_id") @db.Uuid
  status               OrderStatus
  paymentMethod        PaymentMethod @map("payment_method")
  subtotalPaise        Int           @map("subtotal_paise")
  discountPaise        Int           @default(0) @map("discount_paise")
  walletPaise          Int           @default(0) @map("wallet_paise")
  shippingPaise        Int           @default(0) @map("shipping_paise")
  codFeePaise          Int           @default(0) @map("cod_fee_paise")
  /// GST contained in the total (prices are tax-inclusive, so this is not added on top).
  taxPaise             Int           @map("tax_paise")
  totalPaise           Int           @map("total_paise")
  /// Snapshot at checkout; later address edits never change past orders.
  shippingAddress      Json          @map("shipping_address")
  discountId           String?       @map("discount_id") @db.Uuid
  idempotencyKey       String        @map("idempotency_key")
  /// Prepaid orders release reserved stock after this time if still unpaid.
  reservationExpiresAt DateTime?     @map("reservation_expires_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer   User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discount   Discount?           @relation(fields: [discountId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  events     OrderEvent[]
  payments   Payment[]
  refunds    Refund[]
  invoice    Invoice?
  redemption DiscountRedemption?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

/// Snapshot of what was sold. Catalog edits never change these rows.
model OrderItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  /// Kept for reporting; may point at a since-deactivated variant/bundle.
  variantId       String? @map("variant_id") @db.Uuid
  bundleId        String? @map("bundle_id") @db.Uuid
  bundleSelection Json?   @map("bundle_selection")
  productName     String  @map("product_name")
  variantName     String  @map("variant_name")
  sku             String
  hsnCode         String  @map("hsn_code")
  gstRateBps      Int     @map("gst_rate_bps")
  unitPricePaise  Int     @map("unit_price_paise")
  quantity        Int
  lineTotalPaise  Int     @map("line_total_paise")
  /// This line's share of the order discount; taxable value = line total − discount.
  discountPaise   Int     @default(0) @map("discount_paise")
  taxPaise        Int     @map("tax_paise")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  bundle  Bundle?  @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// Append-only (UPDATE/DELETE blocked by trigger). One row per status change.
model OrderEvent {
  id         BigInt          @id @default(autoincrement())
  orderId    String          @map("order_id") @db.Uuid
  fromStatus OrderStatus?    @map("from_status")
  toStatus   OrderStatus     @map("to_status")
  actor      OrderEventActor
  /// Admin user id, webhook event id, etc.
  actorRef   String?         @map("actor_ref")
  note       String?
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ─────────────────────────── Payments ────────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  amountPaise       Int           @map("amount_paise")
  status            PaymentStatus @default(created)
  /// upi, card, netbanking, wallet… as reported by Razorpay.
  method            String?
  errorCode         String?       @map("error_code")
  errorDescription  String?       @map("error_description")
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  /// Null for COD refunds paid out manually.
  paymentId        String?      @map("payment_id") @db.Uuid
  razorpayRefundId String?      @unique @map("razorpay_refund_id")
  amountPaise      Int          @map("amount_paise")
  status           RefundStatus @default(pending)
  method           RefundMethod @default(razorpay)
  /// Bank/UPI transaction reference (UTR) for a manual refund.
  reference        String?
  /// Admin refunds: the request's Idempotency-Key, so a repeated click can't refund twice.
  idempotencyKey   String?      @map("idempotency_key")
  reason           String
  createdBy        String       @map("created_by")
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNote CreditNote?

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@map("refunds")
}

// ────────────────────────────── Tax ──────────────────────────────

/// Gapless counters, one per kind per financial year (April–March), e.g. "2026-27".
/// Numbers are taken with SELECT … FOR UPDATE inside the issuing transaction.
model InvoiceSeries {
  id            String            @id @default(uuid(7)) @db.Uuid
  kind          InvoiceSeriesKind
  financialYear String            @map("financial_year")
  prefix        String
  nextNumber    Int               @default(1) @map("next_number")

  invoices    Invoice[]
  creditNotes CreditNote[]

  @@unique([kind, financialYear])
  @@map("invoice_series")
}

model Invoice {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderId           String   @unique @map("order_id") @db.Uuid
  seriesId          String   @map("series_id") @db.Uuid
  sequence          Int
  /// Full printed number, e.g. "INV/26-27/000123" (max 16 characters; format pending CA confirmation).
  number            String   @unique
  sellerGstin       String   @map("seller_gstin")
  sellerStateCode   String   @map("seller_state_code") @db.Char(2)
  placeOfSupplyCode String   @map("place_of_supply_code") @db.Char(2)
  taxableValuePaise Int      @map("taxable_value_paise")
  cgstPaise         Int      @default(0) @map("cgst_paise")
  sgstPaise         Int      @default(0) @map("sgst_paise")
  igstPaise         Int      @default(0) @map("igst_paise")
  totalPaise        Int      @map("total_paise")
  /// Snapshot: legal name, address, FSSAI licence number.
  seller            Json
  /// Snapshot: name and delivery address (no phone number).
  buyer             Json
  /// Snapshot: DocumentLine[] from packages/shared/src/invoice.ts.
  lines             Json
  pdfKey            String?  @map("pdf_key")
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  series      InvoiceSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@unique([seriesId, sequence])
  @@map("invoices")
}

model CreditNote {
  id                String   @id @default(uuid(7)) @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  refundId          String?  @unique @map("refund_id") @db.Uuid
  seriesId          String   @map("series_id") @db.Uuid
  sequence          Int
  number            String   @unique
  taxableValuePaise Int      @map("taxable_value_paise")
  cgstPaise         Int      @default(0) @map("cgst_paise")
  sgstPaise         Int      @default(0) @map("sgst_paise")
  igstPaise         Int      @default(0) @map("igst_paise")
  totalPaise        Int      @map("total_paise")
  reason            String
  /// Snapshot: CreditNoteLine[] from packages/shared/src/invoice.ts.
  lines             Json
  pdfKey            String?  @map("pdf_key")
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  invoice Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refund  Refund?       @relation(fields: [refundId], references: [id], onDelete: Restrict)
  series  InvoiceSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([seriesId, sequence])
  @@index([invoiceId])
  @@map("credit_notes")
}

// ─────────────────────────── Platform ────────────────────────────

/// Fixed roles; what each may do is decided in code (@AdminController roles).
enum AdminRole {
  owner
  operations
  support

  @@map("admin_role")
}

/// Admin panel staff. Never deleted (audit_log points here); disabled instead.
model AdminUser {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-case.
  email             String    @unique
  name              String
  role              AdminRole
  /// scrypt hash with its parameters and salt (see modules/admin/password.ts).
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// Authenticator-app key, AES-256-GCM encrypted with ADMIN_TOTP_KEY. Set at first login.
  totpSecret        String?   @map("totp_secret")
  /// Null until the admin has proved the app works by entering a code.
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last 30-second step accepted, so a code can't be used twice.
  totpLastStep      Int?      @map("totp_last_step")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  AdminSession[]
  auditLogs AuditLog[]

  @@map("admin_users")
}

/// Admin refresh sessions: same rotation and reuse detection as customer sessions, but
/// rotation never extends the session past its first expiry (one working day).
model AdminSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  /// HMAC-SHA256 (keyed with ADMIN_JWT_SECRET) of the refresh token.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser  AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  replacedBy AdminSession? @relation("AdminSessionRotation", fields: [replacedById], references: [id])
  replaces   AdminSession? @relation("AdminSessionRotation")

  @@index([adminUserId])
  @@index([familyId])
  @@map("admin_sessions")
}

/// Append-only (UPDATE/DELETE blocked by trigger). One row per admin action (CLAUDE.md §8).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  /// Null for actions taken by the system or the command line.
  adminUserId String?  @map("admin_user_id") @db.Uuid
  /// e.g. "admin.login", "order.cancel".
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  /// What changed, e.g. { before, after }. Never secrets.
  changes     Json     @default("{}")
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Every inbound webhook, stored before processing. Unique per source → processed once.
model WebhookEvent {
  id              String        @id @default(uuid(7)) @db.Uuid
  source          WebhookSource
  externalEventId String        @map("external_event_id")
  eventType       String        @map("event_type")
  payload         Json
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?     @map("processed_at") @db.Timestamptz(3)
  attempts        Int           @default(0)
  error           String?

  @@unique([source, externalEventId])
  @@index([processedAt])
  @@map("webhook_events")
}

/// Business settings (fees, thresholds, offers). Keys and value types: @brand/shared settings.ts.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by")

  @@map("settings")
}
